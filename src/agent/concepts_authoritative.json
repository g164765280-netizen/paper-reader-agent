      "related": [
        "precision",
        "recall",
        "iou"
      ],
      "source": "docs/遥感方法知识地图.md §1.6"
    },
    {
      "id": "iou",
      "term": "IoU",
      "term_zh": "交并比",
      "aliases": [
        "Intersection over Union",
        "Jaccard"
      ],
      "category": "metric",
      "definition": "预测与真值交集/并集。",
      "explanation": "对边界敏感，反映分割质量；类不平衡时比 OA 更有意义。",
      "related": [
        "miou",
        "f1"
      ],
      "source": "docs/遥感方法知识地图.md §1.6"
    },
    {
      "id": "miou",
      "term": "mIoU",
      "term_zh": "平均交并比",
      "aliases": [
        "mean IoU"
      ],
      "category": "metric",
      "definition": "各类别 IoU 的平均。",
      "explanation": "语义分割/SCD 常用。",
      "related": [
        "iou"
      ],
      "source": "docs/遥感方法知识地图.md §1.6"
    },
    {
      "id": "oa",
      "term": "OA (Overall Accuracy)",
      "term_zh": "整体准确率",
      "aliases": [
        "OA"
      ],
      "category": "metric",
      "definition": "分类正确的像素占总像素比例。",
      "explanation": "变化检测里严重失真：变化像素占比极小(<5%)，全预测'不变'也能 95%+，不能当主指标。",
      "related": [
        "class_imbalance",
        "f1"
      ],
      "source": "docs/遥感方法知识地图.md §1.6/§1.7"
    },
    {
      "id": "precision",
      "term": "Precision",
      "term_zh": "精确率",
      "aliases": [],
      "category": "metric",
      "definition": "预测为变化里真正变化的比例。",
      "explanation": "反映误报；Precision 高 Recall 低说明漏检严重。",
      "related": [
        "recall",
        "f1"
      ],
      "source": "docs/遥感方法知识地图.md §1.6"
    },
    {
      "id": "recall",
      "term": "Recall",
      "term_zh": "召回率",
      "aliases": [],
      "category": "metric",
      "definition": "真正变化里被检出的比例。",
      "explanation": "反映漏检；看应用偏重误报还是漏检。",
      "related": [
        "precision",
        "f1"
      ],
      "source": "docs/遥感方法知识地图.md §1.6"
    },
    {
      "id": "class_imbalance",
      "term": "Class Imbalance",
      "term_zh": "类别不平衡",
      "aliases": [],
      "category": "pitfall",
      "definition": "变化像素占比极小，正负样本严重不平衡。",
      "explanation": "变化检测核心问题：导致 OA 虚高、模型偏向'不变'；应对可用 Focal Loss、Dice 等。",
      "related": [
        "oa",
        "small_object"
      ],
      "source": "docs/遥感方法知识地图.md §1.7"
    },
    {
      "id": "pseudo_change",
      "term": "Pseudo-change",
      "term_zh": "伪变化",
      "aliases": [],
      "category": "pitfall",
      "definition": "并非真实地表变化却被判为变化。",
      "explanation": "来源：配准误差、季节/光照变化。",
      "related": [
        "registration_error",
        "class_imbalance"
      ],
      "source": "docs/遥感方法知识地图.md §1.7"
    },
    {
      "id": "registration_error",
      "term": "Registration Error",
      "term_zh": "配准误差",
      "aliases": [
