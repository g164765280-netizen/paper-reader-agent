# API 配置模板 —— 复制本文件为 .env 并填入真实值，.env 已被 .gitignore 忽略，不会提交。
#
# 用法：运行脚本前执行  source .env  或  export 这些变量。

# 远程 LLM API（用于评测 judge / 出题 / 数字题等需要第三方 API 的场景）
OPENAI_API_KEY=sk_tr_xxxxxxxxxxxxxxxx
OPENAI_API_BASE=https://tokenrhythm.studio/v1

# 可选：评测用的 judge 模型
JUDGE_MODEL=qwen3.8-max

# 本地答题模型走 vLLM（:8000），不需要 API key，无需在此配置。